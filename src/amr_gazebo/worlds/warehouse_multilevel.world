    <!-- ===== Dynamic obstacles ===== -->

    <model name="ped_0">
      <pose>-14.0000 -7.3000 0.8750 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>70.00</mass>
          <inertia>
            <ixx>17.8646</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>17.8646</iyy><iyz>0</iyz>
            <izz>3.5840</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.320</radius><length>1.750</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.320</radius><length>1.750</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Purple</name>
            </script>
          </material>
        </visual>
      </link>

      <!-- Holonomic drive so dynamic_obstacle_driver can steer it with a
           plain Twist. Odometry is namespaced to keep the fleet TF tree
           clean. -->
      <plugin name="ped_0_move" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/obstacles/ped_0</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>50</update_rate>
        <publish_rate>10</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <odometry_frame>obstacles/ped_0/odom</odometry_frame>
        <robot_base_frame>obstacles/ped_0/base_link</robot_base_frame>
        <covariance_x>0.0001</covariance_x>
        <covariance_y>0.0001</covariance_y>
        <covariance_yaw>0.01</covariance_yaw>
      </plugin>
    </model>

