        <publish_rate>10</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <odometry_frame>obstacles/thirdparty_0/odom</odometry_frame>
        <robot_base_frame>obstacles/thirdparty_0/base_link</robot_base_frame>
        <covariance_x>0.0001</covariance_x>
        <covariance_y>0.0001</covariance_y>
        <covariance_yaw>0.01</covariance_yaw>
      </plugin>
    </model>

    <model name="thirdparty_1">
      <pose>10.0000 0.0000 0.2500 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>40.00</mass>
          <inertia>
            <ixx>0.8333</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.8333</iyy><iyz>0</iyz>
            <izz>4.0500</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.900 0.900 0.500</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.900 0.900 0.500</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>

      <!-- Holonomic drive so dynamic_obstacle_driver can steer it with a
           plain Twist. Odometry is namespaced to keep the fleet TF tree
           clean. -->
      <plugin name="thirdparty_1_move" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/obstacles/thirdparty_1</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>50</update_rate>
        <publish_rate>10</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <odometry_frame>obstacles/thirdparty_1/odom</odometry_frame>
        <robot_base_frame>obstacles/thirdparty_1/base_link</robot_base_frame>
        <covariance_x>0.0001</covariance_x>
        <covariance_y>0.0001</covariance_y>
        <covariance_yaw>0.01</covariance_yaw>
      </plugin>
    </model>

  </world>
</sdf>
