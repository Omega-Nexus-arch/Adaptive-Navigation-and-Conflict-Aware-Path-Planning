<?xml version="1.0"?>
<!--
  Sensor suite: 2D LiDAR, IMU and a forward camera.

  Every Gazebo sensor publishes onto a *_raw topic. Nothing in the navigation
  stack subscribes to those topics directly - they are consumed exclusively by
  amr_sensor_bsp, which republishes validated copies on the plain topic names.
  Wiring the raw/validated split here (rather than in a remap somewhere) makes
  the BSP gate structurally impossible to bypass by accident.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================================================================
       2D LiDAR
       ==================================================================== -->
  <xacro:macro name="amr_lidar" params="prefix robot_name cfg base_height deck_height">
    <!-- The mast that lifts the scanner clear of the cargo deck.

         A 2D scanner mounted at or below deck height is not a scanner: a
         Gazebo ray sensor collides with its OWN model's links, so every beam
         terminates on the chassis wall a few tens of centimetres out - beyond
         range_min, therefore indistinguishable from a real obstacle. See
         DESIGN_NOTES 8d.

         The mast is visual-only on purpose. Giving it collision geometry would
         put a solid body at the beam origin; the returns would fall below
         range_min and be discarded, but relying on that is a coincidence, not
         a design. No collision means no possible self-hit. -->
    <link name="${prefix}lidar_mast">
      <visual>
        <origin xyz="0 0 ${(cfg['height'] - deck_height) / 2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="0.028" length="${cfg['height'] - deck_height}"/></geometry>
        <material name="${prefix}dark_material"/>
      </visual>
      <xacro:null_inertia mass="0.25"/>
    </link>

    <joint name="${prefix}lidar_mast_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}lidar_mast"/>
      <origin xyz="0 0 ${deck_height - base_height}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}lidar_link">
      <visual>
        <geometry><cylinder radius="0.045" length="0.05"/></geometry>
        <material name="${prefix}dark_material"/>
      </visual>
      <!-- No collision element. The scanner's own housing sits exactly at the
           beam origin; a collision shell of radius 0.045 m would be struck by
           every beam of any model whose range_min is below that. -->
      <xacro:null_inertia mass="0.18"/>
    </link>

    <joint name="${prefix}lidar_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}lidar_link"/>
      <origin xyz="${0.0} 0 ${cfg['height'] - base_height}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}lidar_link">
      <material>Gazebo/Red</material>
      <sensor name="${robot_name}_lidar" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>${cfg['rate']}</update_rate>
        <always_on>true</always_on>
        <ray>
          <scan>
            <horizontal>
              <samples>${cfg['samples']}</samples>
              <resolution>1</resolution>
              <min_angle>${cfg['min_angle']}</min_angle>
              <max_angle>${cfg['max_angle']}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${cfg['range_min']}</min>
            <max>${cfg['range_max']}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${cfg['noise_stddev']}</stddev>
          </noise>
        </ray>
        <plugin name="${robot_name}_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/${robot_name}</namespace>
            <remapping>~/out:=scan_raw</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${prefix}lidar_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ====================================================================
       IMU
       ==================================================================== -->
  <xacro:macro name="amr_imu" params="prefix robot_name cfg base_height">
    <link name="${prefix}imu_link">
      <visual>
        <geometry><box size="0.035 0.035 0.012"/></geometry>
        <material name="${prefix}dark_material"/>
      </visual>
      <xacro:null_inertia mass="0.03"/>
    </link>

    <joint name="${prefix}imu_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}imu_link"/>
      <origin xyz="0 0 ${cfg['height'] - base_height}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}imu_link">
      <material>Gazebo/Green</material>
      <gravity>true</gravity>
      <sensor name="${robot_name}_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>${cfg['rate']}</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean>
               <stddev>${cfg['gyro_noise_stddev']}</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean>
               <stddev>${cfg['gyro_noise_stddev']}</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean>
               <stddev>${cfg['gyro_noise_stddev']}</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean>
               <stddev>${cfg['accel_noise_stddev']}</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean>
               <stddev>${cfg['accel_noise_stddev']}</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean>
               <stddev>${cfg['accel_noise_stddev']}</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="${robot_name}_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/${robot_name}</namespace>
            <remapping>~/out:=imu_raw</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>${prefix}imu_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ====================================================================
       Forward RGB camera
       Used by the BSP validation toolkit (the evaluation rubric calls for
       validation output on the IMU *and* the camera).
       ==================================================================== -->
  <xacro:macro name="amr_camera" params="prefix robot_name cfg base_height body_length">
    <link name="${prefix}camera_link">
      <visual>
        <geometry><box size="0.02 0.09 0.025"/></geometry>
        <material name="${prefix}dark_material"/>
      </visual>
      <xacro:null_inertia mass="0.06"/>
    </link>

    <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}camera_link"/>
      <!-- 2 cm proud of the front face. Flush with it would bury the lens
           inside the chassis collision box, so the near plane starts inside
           solid geometry. -->
      <origin xyz="${body_length / 2.0 + 0.02} 0 ${cfg['height'] - base_height}" rpy="0 0 0"/>
    </joint>

    <!-- REP-103 optical frame (z forward, x right, y down). -->
    <link name="${prefix}camera_optical_link"/>
    <joint name="${prefix}camera_optical_joint" type="fixed">
      <parent link="${prefix}camera_link"/>
      <child  link="${prefix}camera_optical_link"/>
      <origin xyz="0 0 0" rpy="${-pi/2.0} 0 ${-pi/2.0}"/>
    </joint>

    <gazebo reference="${prefix}camera_link">
      <material>Gazebo/Yellow</material>
      <sensor name="${robot_name}_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>${cfg['rate']}</update_rate>
        <visualize>false</visualize>
        <camera name="${robot_name}_camera">
          <horizontal_fov>${cfg['hfov']}</horizontal_fov>
          <image>
            <width>${cfg['width']}</width>
            <height>${cfg['height_px']}</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>40.0</far></clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.006</stddev>
          </noise>
        </camera>
        <plugin name="${robot_name}_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/${robot_name}</namespace>
          </ros>
          <!-- Named `camera_raw`, so the plugin publishes
               /<robot>/camera_raw/image_raw of its own accord and the BSP layer
               republishes the validated copy as /<robot>/camera/image_raw.

               The earlier version kept the name `camera` and remapped
               `~/image_raw`. gazebo_ros_camera resolves `~` against its own
               internal node, not against the sensor, so the remap silently
               matched nothing and no image was ever published. Choosing the
               name is deterministic; remapping `~` is not. -->
          <camera_name>camera_raw</camera_name>
          <frame_name>${prefix}camera_optical_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
