<?xml version="1.0"?>
<!--
  Gazebo-only attachments: the differential drive controller and the joint
  state source. Kept in its own file so a real-hardware bringup can include
  amr_base.xacro + sensors.xacro without dragging simulation plugins along.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="amr_gazebo_control" params="prefix robot_name m">

    <!-- ================================================================
         Differential drive
         `cmd_vel` here is the FINAL arbitrated command. The chain is:

           nav2 controller
             -> /<ns>/cmd_vel_nav
                -> velocity_smoother  (traffic scaling + accel/jerk limiting)
                   -> /<ns>/cmd_vel_smoothed
                      -> safety_override  (immediate halt, bypasses the above)
                         -> /<ns>/cmd_vel   (consumed below)

         Nothing else may publish to cmd_vel; the safety node is the sole
         writer, which is what makes the override authoritative.
         ================================================================ -->
    <gazebo>
      <plugin name="${robot_name}_diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>/${robot_name}</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>

        <update_rate>50.0</update_rate>

        <left_joint>${prefix}left_wheel_joint</left_joint>
        <right_joint>${prefix}right_wheel_joint</right_joint>

        <wheel_separation>${m['wheel_separation']}</wheel_separation>
        <wheel_diameter>${2.0 * m['wheel_radius']}</wheel_diameter>

        <max_wheel_torque>${m['wheel_torque']}</max_wheel_torque>
        <!-- Plant-level acceleration ceiling. Set generously above the
             smoother's limits so that observed smoothness is demonstrably the
             work of our controller, not of a saturating simulator. -->
        <max_wheel_acceleration>${m['max_accel_x'] * 4.0}</max_wheel_acceleration>

        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>

        <odometry_topic>odom</odometry_topic>
        <odometry_frame>${prefix}odom</odometry_frame>
        <robot_base_frame>${prefix}base_footprint</robot_base_frame>
        <odometry_source>1</odometry_source>
      </plugin>
    </gazebo>

    <!-- Joint states so robot_state_publisher can complete the TF tree. -->
    <gazebo>
      <plugin name="${robot_name}_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <namespace>/${robot_name}</namespace>
          <remapping>~/out:=joint_states</remapping>
        </ros>
        <update_rate>50.0</update_rate>
        <joint_name>${prefix}left_wheel_joint</joint_name>
        <joint_name>${prefix}right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
