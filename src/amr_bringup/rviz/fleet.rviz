# GENERATED for the shipped two-robot roster.
# Regenerate for a different fleet size with the snippet in
# docs/ARCHITECTURE.md; the displays are built by iterating the roster, so a
# ten-robot config is the same code with a different input.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 700
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - ''
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Name: root
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 50
    Line Style:
      Value: Lines
    Color: 160; 160; 164
    Alpha: 0.3
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/Map
    Name: Fused fleet map
    Enabled: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 1
    Color Scheme: map
    Alpha: 0.7
    Draw Behind: true
  - Class: rviz_default_plugins/Map
    Name: Slope cost (amr1)
    Enabled: false
    Topic:
      Value: /amr1/global_costmap/global_costmap/slope_layer/slope_cost
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 1
    Color Scheme: costmap
    Alpha: 0.6
    Draw Behind: false
  - Class: rviz_default_plugins/MarkerArray
    Name: Predicted conflicts
    Enabled: true
    Topic:
      Value: /fleet/conflict_markers
      Depth: 10
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/RobotModel
    Name: amr1 model
    Enabled: true
    Alpha: 1.0
    Description Topic:
      Value: /amr1/robot_description
      Durability Policy: Volatile
      Reliability Policy: Reliable
      Depth: 1
  - Class: rviz_default_plugins/LaserScan
    Name: amr1 scan (validated)
    Enabled: true
    Size (m): 0.04
    Style: Points
    Color: 38; 89; 191
    Color Transformer: FlatColor
    Alpha: 1.0
    Topic:
      Value: /amr1/scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Path
    Name: amr1 global plan
    Enabled: true
    Color: 38; 89; 191
    Line Style: Lines
    Alpha: 1.0
    Topic:
      Value: /amr1/plan
      Depth: 1
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Map
    Name: amr1 local costmap
    Enabled: false
    Topic:
      Value: /amr1/local_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 1
    Color Scheme: costmap
    Alpha: 0.5
  - Class: rviz_default_plugins/RobotModel
    Name: amr2 model
    Enabled: true
    Alpha: 1.0
    Description Topic:
      Value: /amr2/robot_description
      Durability Policy: Volatile
      Reliability Policy: Reliable
      Depth: 1
  - Class: rviz_default_plugins/LaserScan
    Name: amr2 scan (validated)
    Enabled: true
    Size (m): 0.04
    Style: Points
    Color: 216; 114; 25
    Color Transformer: FlatColor
    Alpha: 1.0
    Topic:
      Value: /amr2/scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Path
    Name: amr2 global plan
    Enabled: true
    Color: 216; 114; 25
    Line Style: Lines
    Alpha: 1.0
    Topic:
      Value: /amr2/plan
      Depth: 1
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Map
    Name: amr2 local costmap
    Enabled: false
    Topic:
      Value: /amr2/local_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 1
    Color Scheme: costmap
    Alpha: 0.5
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /amr1/goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 45.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 1.35
      Yaw: 3.14
      Target Frame: <Fixed Frame>
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1700
  Views:
    collapsed: false
